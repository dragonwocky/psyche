---
import Search from "../components/Search";

interface Props {
  title: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title} · psyche + Astro</title>
  </head>
  <body>
    <header><a href="/">Home</a> · <kbd>⌘/CTRL + K</kbd> to search</header>
    <article>
      <h1>{Astro.props.title}</h1>
      <slot />
    </article>
    <Search client:only="solid-js" />
  </body>
</html>

<style is:global>
  body { max-width: 40rem; margin: 2rem auto; padding: 0 1rem; font-family: system-ui, sans-serif; }
  ::highlight(psyche) { background-color: #fde047; color: #111; }
  .search { position: fixed; inset: 0; display: none; justify-content: center; align-items: start; }
  .search.open { display: flex; }
  .backdrop { position: absolute; inset: 0; background: rgb(0 0 0 / 0.4); }
  .panel { position: relative; width: min(40rem, 90vw); margin-top: 10vh; padding: 0.75rem; background: white; border-radius: 0.75rem; }
  .bar { display: flex; gap: 0.25rem; }
  .bar input { flex: 1; padding: 0.5rem; font: inherit; }
  .panel h2 { margin: 0.75rem 0 0.25rem; font-size: 0.75rem; color: #b91c1c; }
  .result { display: block; padding: 0.5rem 0.75rem; border-radius: 0.5rem; color: inherit; text-decoration: none; }
  .result.selected { background: #f1f5f9; }
  .result p { margin: 0.25rem 0; font-size: 0.875rem; color: #475569; }
  .tag { margin-right: 0.375rem; padding: 0 0.5rem; font-size: 0.75rem; border: 1px solid #cbd5e1; border-radius: 999px; }
  footer { display: flex; justify-content: space-between; margin-top: 0.75rem; font-size: 0.75rem; color: #64748b; }
</style>
